<?xml version="1.0" encoding="utf-8"?>
<!--
  AxSynth installer (WiX Toolset v4).
  Build: scripts/build-msi.ps1 -Version x.y.z -Bundle <path to AxSynth.vst3 bundle folder>
  Variables:
    ProductVersion  (-d ProductVersion=x.y.z)   version from the git tag
    BundleDir       (-d BundleDir=...)          the AxSynth.vst3 bundle folder
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode must never change: it ties all AxSynth versions together for MajorUpgrade. -->
  <Package Name="AxSynth"
           Manufacturer="AxSynth"
           Version="$(var.ProductVersion)"
           UpgradeCode="89852B91-1B03-477C-ACF2-4A097E5FE20A"
           Scope="perMachine"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="AxSynth VST3 instrument" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of AxSynth is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- License, install folder, install, finish. The user picks the VST3 folder;
         the AxSynth.vst3 bundle goes inside it. Default: Common Files\VST3. -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Upgrades and repairs reuse the folder chosen at first install. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\AxSynth"
                      Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>

    <!-- [INSTALLFOLDER]\AxSynth.vst3\..., default C:\Program Files\Common Files\VST3 -->
    <StandardDirectory Id="CommonFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VST3">
        <Directory Id="BundleFolder" Name="AxSynth.vst3">
          <Directory Id="ContentsFolder" Name="Contents">
            <Directory Id="BinaryFolder" Name="x86_64-win" />
            <Directory Id="ResourcesFolder" Name="Resources" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="AxSynth VST3" Level="1">
      <Component Directory="BinaryFolder">
        <File Id="PluginBinary" Source="$(var.BundleDir)\Contents\x86_64-win\AxSynth.vst3" KeyPath="yes" />
      </Component>
      <Component Directory="ResourcesFolder">
        <File Id="ModuleInfo" Source="$(var.BundleDir)\Contents\Resources\moduleinfo.json" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\AxSynth" Name="InstallFolder" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
